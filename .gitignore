*.pdb.meta
*.mdb.meta

# Crash reports & OS files
sysinfo.txt
Thumbs.db
ehthumbs.db
.DS_Store
.DS_Store?
._*

# Builds
*.apk
*.unityweb

# Personal and grant documents
*.pdf
*.docx
*.doc
*.xlsx
*.xls

*.aab
*.unitypackage
*.app
Build/
Builds/
