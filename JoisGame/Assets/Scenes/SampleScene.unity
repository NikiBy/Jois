  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Jois.Level.HouseTrigger
  lessonNumber: 1
  lessonTitle: "\u0423\u0440\u043E\u043A 1: \u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432 C++"
  lessonTheory: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0432 \u043C\u0438\u0440 C++!\n\n\u041B\u044E\u0431\u0430\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u043D\u0430 C++ \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441 \u0444\u0443\u043D\u043A\u0446\u0438\u0438 main():\nint main() {\n    std::cout << \"Hello, World!\";\n    return 0;\n}\n\n\u2022 std::cout \u2014 \u0432\u044B\u0432\u043E\u0434 \u0442\u0435\u043A\u0441\u0442\u0430 \u043D\u0430 \u044D\u043A\u0440\u0430\u043D.\n\u2022 return 0 \u2014 \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442 \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u043E\u0431 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u043C \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B."
  promptMessage: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 [E], \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0439\u0442\u0438 \u0432 \u0423\u0440\u043E\u043A"
