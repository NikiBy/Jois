  lessonNumber: 2
  lessonTitle: "\u0423\u0440\u043E\u043A 2: \u041B\u0430\u0432\u043A\u0430 \u0442\u0438\u043F\u043E\u0432"
  theoryText: "\u042F\u0437\u044B\u043A C++ \u2014 \u044F\u0437\u044B\u043A \u0441\u043E \u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0442\u0440\u043E\u0433\u043E\u0439 \u0442\u0438\u043F\u0438\u0437\u0430\u0446\u0438\u0435\u0439. \u041F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u043C\u043E\u0436\u0435\u0442 \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0435 \u0441 \u043D\u0435\u0439 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F:\n\n\u2022 int \u2014 \u0446\u0435\u043B\u044B\u0435 \u0447\u0438\u0441\u043B\u0430 (42, -5)\n\u2022 double / float \u2014 \u0447\u0438\u0441\u043B\u0430 \u0441 \u043F\u043B\u0430\u0432\u0430\u044E\u0449\u0435\u0439 \u0442\u043E\u0447\u043A\u043E\u0439 (3.14)\n\u2022 char \u2014 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0441\u0438\u043C\u0432\u043E\u043B \u0432 \u043E\u0434\u0438\u043D\u0430\u0440\u043D\u044B\u0445 \u043A\u0430\u0432\u044B\u0447\u043A\u0430\u0445 ('A')\n\u2022 bool \u2014 \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 (true / false)\n\n\u0414\u0432\u043E\u0439\u043D\u044B\u0435 \u043A\u0430\u0432\u044B\u0447\u043A\u0438 (\"...\") \u0437\u0430\u0434\u0430\u044E\u0442 \u0441\u0442\u0440\u043E\u043A\u043E\u0432\u044B\u0439 \u043B\u0438\u0442\u0435\u0440\u0430\u043B, \u0430 \u043D\u0435 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439 \u0441\u0438\u043C\u0432\u043E\u043B char!"
  lessonType: 1
  quizQuestion: 
  quizAnswers: []
  correctQuizIndex: 0
  quizExplanation: 
  bugTaskDescription: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0441\u0442\u0440\u043E\u043A\u0443 \u0441 \u043D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u043C \u043F\u0440\u0438\u0441\u0432\u0430\u0438\u0432\u0430\u043D\u0438\u0435\u043C \u0442\u0438\u043F\u0430 \u0434\u0430\u043D\u043D\u044B\u0445:"
  codeLines:
  - '1: #include <iostream>'
  - '2: int main() {'
  - '3:     int age = 19;'
  - '4:     double gpa = 4.75;'
  - '5:     char group = "A";'
  - '6:     bool isStudent = true;'
  - '7:     return 0;'
  - '8: }'
  bugLineIndex: 4
  bugExplanation: "\u0414\u043B\u044F \u0442\u0438\u043F\u0430 char \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F \u043E\u0434\u0438\u043D\u0430\u0440\u043D\u044B\u0435 \u043A\u0430\u0432\u044B\u0447\u043A\u0438 ('A'). \u0414\u0432\u043E\u0439\u043D\u044B\u0435 \u043A\u0430\u0432\u044B\u0447\u043A\u0438 \u0437\u0430\u0434\u0430\u044E\u0442 \u0441\u0442\u0440\u043E\u043A\u0443!"
  generalHint: "\u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u0442\u0438\u043F\u044B \u043A\u0430\u0432\u044B\u0447\u0435\u043A \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0441\u0438\u043C\u0432\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430 char."
