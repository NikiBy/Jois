  m_Name: LessonData_Level10
  m_EditorClassIdentifier: Assembly-CSharp::Jois.Level.LessonData
  lessonNumber: 10
  lessonTitle: "\u0423\u0440\u043E\u043A 10: \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u042D\u043A\u0437\u0430\u043C\u0435\u043D"
  theoryText: "\u041F\u0430\u043C\u044F\u0442\u044C, \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u043D\u0430\u044F \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u043C new[] (\u0434\u043B\u044F \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043C\u0430\u0441\u0441\u0438\u0432\u043E\u0432), \u043E\u0431\u044F\u0437\u0430\u043D\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u043C delete[].\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u043E\u0433\u043E delete \u0432\u043C\u0435\u0441\u0442\u043E delete[] \u0434\u043B\u044F \u043C\u0430\u0441\u0441\u0438\u0432\u0430 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u043A \u0443\u0442\u0435\u0447\u043A\u0430\u043C \u043F\u0430\u043C\u044F\u0442\u0438 \u0438 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044E \u043A\u0443\u0447\u0438 (Heap Corruption)!"
  lessonType: 1
  quizQuestion: 
  quizAnswers: []
  correctQuizIndex: 0
  quizExplanation: 
  bugTaskDescription: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043E\u0448\u0438\u0431\u043A\u0443 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438:"
  codeLines:
  - '1: #include <iostream>'
  - '2: void processData() {'
  - '3:     int* array = new int[100];'
  - '4:     array[0] = 42;'
  - '5:     delete array;'
  - '6: }'
  - '7: int main() {'
  - '8:     processData();'
  - '9:     return 0;'
  - '10: }'
  bugLineIndex: 4
  bugExplanation: "\u041C\u0430\u0441\u0441\u0438\u0432 \u0431\u044B\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0447\u0435\u0440\u0435\u0437 new int[100], \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0443\u0434\u0430\u043B\u044F\u0442\u044C\u0441\u044F \u043E\u0431\u044F\u0437\u0430\u043D \u0447\u0435\u0440\u0435\u0437 delete[] array;!"
  generalHint: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435, \u043A\u0430\u043A \u0432\u044B\u0434\u0435\u043B\u044F\u043B\u0441\u044F \u043C\u0430\u0441\u0441\u0438\u0432 (new[]) \u0438 \u043A\u0430\u043A \u043E\u043D \u0443\u0434\u0430\u043B\u044F\u0435\u0442\u0441\u044F."
