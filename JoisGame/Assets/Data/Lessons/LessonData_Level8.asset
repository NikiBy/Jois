  lessonNumber: 8
  lessonTitle: "\u0423\u0440\u043E\u043A 8: \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u0439"
  theoryText: "\u0415\u0441\u043B\u0438 \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0430 \u0441 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043C\u044B\u043C \u0442\u0438\u043F\u043E\u043C, \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u043C \u043E\u0442 void (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, int, double, bool), \u043E\u043D\u0430 \u043E\u0431\u044F\u0437\u0430\u043D\u0430 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E \u0442\u0438\u043F\u0430 \u0447\u0435\u0440\u0435\u0437 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 return.\n\n\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 return \u0432 \u043D\u0435-void \u0444\u0443\u043D\u043A\u0446\u0438\u0438 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u043A \u043D\u0435\u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u044B\u043C \u043E\u0448\u0438\u0431\u043A\u0430\u043C!"
  lessonType: 1
  quizQuestion: 
  quizAnswers: []
  correctQuizIndex: 0
  quizExplanation: 
  bugTaskDescription: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043E\u0448\u0438\u0431\u043A\u0443 \u0432 \u0442\u0435\u043B\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u0438:"
  codeLines:
  - '1: #include <iostream>'
  - '2: int multiply(int a, int b) {'
  - '3:     int result = a * b;'
  - '4: }'
  - '5: int main() {'
  - '6:     int val = multiply(4, 5);'
  - '7:     return 0;'
  - '8: }'
  bugLineIndex: 2
  bugExplanation: "\u0424\u0443\u043D\u043A\u0446\u0438\u044F multiply \u0438\u043C\u0435\u0435\u0442 \u0442\u0438\u043F \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430 int, \u043D\u043E \u0432 \u0435\u0435 \u0442\u0435\u043B\u0435 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 return result;!"
  generalHint: "\u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043B\u0438 \u0444\u0443\u043D\u043A\u0446\u0438\u044F multiply \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u043D\u043D\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435."
